# Exemplo de configuração de variáveis de ambiente
# Copie este arquivo para .env e preencha com as suas credenciais reais

# Supabase (PostgreSQL + PGVector)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_publishable_key_aqui
SUPABASE_SECRET_KEY=sua_secret_service_role_key_aqui

# OpenRouter (LLM)
OPENROUTER_API_KEY=sua_openrouter_api_key_aqui
